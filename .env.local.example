# Copia este archivo a .env.local y rellénalo. En Vercel: Settings → Environment
# Variables (Production + Preview). Nunca subas .env.local al repositorio.

# ── Obligatorias ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Project Settings → API → service_role (SECRETA, solo servidor)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Session pooler (puerto 5432), con la contraseña de la BD.
# postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Firma la cookie de sesión: cadena larga aleatoria (p. ej. `openssl rand -hex 32`).
# SIN ELLA LA APP QUEDA ABIERTA SIN LOGIN (solo aceptable en desarrollo).
AUTH_SECRET=
# Contraseña maestra del propietario: entra como admin aunque no haya usuarios.
AUTH_PASSWORD=

# ── Recomendadas ─────────────────────────────────────────────────────────────

# Protege /api/cron/* (Vercel la envía sola en las tareas programadas).
CRON_SECRET=

# ── Opcionales: cada integración queda inerte hasta que tenga su clave ───────

# IA (Documentos: leer facturas y tickets · Banco: extractos · Fina).
ANTHROPIC_API_KEY=

# Correo: buzón donde llegan las facturas de proveedor (cron de las 6:00) y
# envío de correos (facturas de venta, confirmaciones). Por defecto Gmail;
# con Gmail hace falta una "contraseña de aplicación".
IMAP_USER=
IMAP_PASSWORD=
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# SMS de confirmación de reservas (https://twilio.com, número emisor).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Recordatorios de reserva por WhatsApp (Meta Cloud API).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es

# Impresora de cocina Star CloudPRNT: la impresora llama a
# /api/impresora/cocina?clave=<IMPRESORA_SECRET>
IMPRESORA_SECRET=

# Agente de voz para reservas por teléfono (ElevenLabs), ver docs/agente-voz.md
VOZ_SECRET=
